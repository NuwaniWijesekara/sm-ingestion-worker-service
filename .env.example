# ── Database / queue ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scanme_db
REDIS_URL=redis://localhost:6379/0
STREAM_NAME=photo.ingest
CONSUMER_GROUP=ingestion-workers
CONSUMER_NAME=worker-1

# ── AWS (S3 + Rekognition) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# ── Google Drive ─────────────────────────────────────────────
GOOGLE_DRIVE_API_KEY=

# ── Free-tier watermark ──────────────────────────────────────
# Logo stamped bottom-right (5% inset) on display images and thumbnails of
# events whose package has has_watermark enabled. PNG with transparency;
# relative paths resolve from the service root. Replace
# assets/watermark.png with the real logo, or point this elsewhere.
# If the file is missing, WATERMARK_TEXT is rendered instead.
WATERMARK_LOGO_PATH=assets/watermark.png
WATERMARK_TEXT=ScanMe
